NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Postgres
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Secrets
SESSION_SECRET="replace-with-a-secure-random-64-character-secret"
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret"
COOKIE_SECRET="replace-with-a-secure-random-64-character-cookie-secret"

# Supabase Storage (Server-Only)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="gifts-galore-media"

# Feature Flags
ENABLE_PUBLIC_SELLER_REGISTRATION=false
