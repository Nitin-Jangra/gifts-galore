# ==========================================
# GIFTS GALORE - ROOT ENVIRONMENT TEMPLATE
# ==========================================

# Server Settings
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Supabase PostgreSQL Connection Pooling & Direct)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication & Sessions
SESSION_SECRET="replace-with-a-secure-random-64-character-secret"
JWT_SECRET="replace-with-a-secure-random-64-character-jwt-secret"
COOKIE_SECRET="replace-with-a-secure-random-64-character-cookie-secret"

# Supabase Storage Configuration (Server-Side Only - NEVER EXPOSE SERVICE KEY TO CLIENT)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET="gifts-galore-media"

# Feature Flags
ENABLE_PUBLIC_SELLER_REGISTRATION=false
